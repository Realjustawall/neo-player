<resources>
    <style name="Theme.NeoPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/neo_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/neo_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NeoPlayer</item>
    </style>
    <style name="Theme.NeoPlayer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
